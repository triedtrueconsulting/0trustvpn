<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Account tokens live in EncryptedSharedPreferences. Their encryption
      key is bound to the device keystore, so a backed-up copy would be
      useless on a restore to a different device anyway. Exclude to keep
      Auto Backup smaller and avoid leaking encrypted-blob metadata.
    -->
    <exclude domain="sharedpref" path="zerotrust_secure.xml" />
</full-backup-content>
