# /etc/0trust/proxy.env — visitor proxy configuration
# Copy to /etc/0trust/proxy.env, chmod 0640, chown root:0trust

ZTV_PROXY_PORT=8081
ZTV_PROXY_PREFIX=/surf

# Host suffixes the proxy refuses. This is the fast lever when an abuse
# complaint arrives — add and `systemctl reload 0trust-proxy`.
ZTV_PROXY_BLOCKLIST=

# Page views before the trial offer sharpens.
ZTV_PROXY_TRIAL_AFTER=3

# Where the control plane is. The banner asks it how long the trial is, so a
# change made in the admin dashboard reaches /surf without editing this file.
ZTV_API_BASE=http://127.0.0.1:8080

# Only used if the control plane cannot be reached — keep it in step with
# ZTV_TRIAL_DAYS in api.env so a cold start advertises the right offer.
ZTV_TRIAL_DAYS=7

ZTV_PROXY_UA=Mozilla/5.0 (compatible; 0trust-surf/1.0; +https://0trustvpn.com/surf)
