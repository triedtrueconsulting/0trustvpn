[Unit]
Description=0trust VPN expiry sweeper
After=0trust-api.service

[Service]
Type=oneshot
User=0trust
Group=0trust
EnvironmentFile=/etc/0trust/api.env
ExecStart=/opt/0trust/api/.venv/bin/python3 /opt/0trust/api/sweep.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/0trust
