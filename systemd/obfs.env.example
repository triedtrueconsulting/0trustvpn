# 0trust obfuscated transport relay — written by node enrolment.
#
# ZTV_OBFS_KEY is base64 of 32 random bytes, minted fresh on every boot along
# with the node's WireGuard key and handed to the control plane in the same
# provision call. It is NOT a secret from customers: every client on this
# node is given it, because it is what lets the relay open their packets.
# It is the node's obfuscation key, not an access credential — WireGuard is
# still the only thing authenticating anybody.
ZTV_OBFS_KEY=
# host:port to listen on. udp/443 blends with QUIC in flow records.
ZTV_OBFS_LISTEN=0.0.0.0:443
# The loopback ports the relay may forward to, and nothing else. The node's
# own WireGuard listener plus the multi-hop entry range. Widening this beyond
# the node's own sockets turns the relay into an open proxy — see the Server
# comment in client/internal/obfs.
ZTV_OBFS_WG_PORTS=51820,52000-59999
