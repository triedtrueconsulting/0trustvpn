# /etc/0trust/api.env
# Owned root:0trust, mode 0640
# Generate the PSKs with:  openssl rand -hex 32

ZTV_DB_PATH=/var/lib/0trust/0trust.db

# --- BTCPay Server ---
BTCPAY_URL=https://btcpay.your-domain.tld
BTCPAY_STORE_ID=replace-me
BTCPAY_API_KEY=replace-me
BTCPAY_WEBHOOK_SECRET=replace-me-with-openssl-rand-hex-32

# --- Mesh ---
MESH_NETWORK=10.64.0.0/10
NODE_API_PSK=replace-me-with-openssl-rand-hex-32

# --- Payment provider -------------------------------------------------------
# watch  = derive a receive address per invoice from your own extended PUBLIC
#          key and confirm it against a PUBLIC block explorer. Non-custodial,
#          no account anywhere, no chain data on this box. The default, and
#          the only one that works on a VPS you built this morning.
# btcpay = BTCPay Server, yours or somebody else's. Non-custodial and takes
#          more coins, but a BTCPay instance has a full node behind it —
#          hundreds of GB of chain if you host it yourself.
# hosted = commercial gateway. No infrastructure at all; custodial, usually
#          KYC'd, and can freeze or reverse.
# stripe / square = cards. A real identity behind every payment.
#
# This said btcpay, which is not what scripts/install.sh writes and not what
# works without more infrastructure. An operator who copied this file got a
# provider they had not set up, and 0trust-poll.timer — which only runs for
# `watch` — then credited nothing while addresses kept taking real money.
ZTV_PAYMENT_PROVIDER=watch

# When ZTV_PAYMENT_PROVIDER=watch. Your extended PUBLIC key (zpub/xpub) — the
# public half only; nothing here can sign. A plain address works too and is
# reused for every invoice, which makes two payments of the same amount
# impossible to tell apart. Verify with scripts/check-wallet.sh before taking
# money: a wrong key derives valid addresses belonging to somebody else.
#WALLET_BTC=
#WALLET_ZEC=
# Public explorers. Any Esplora instance for BTC; Esplora or Blockchair for
# ZEC, chosen from the URL. Defaults are mempool.space and Blockchair.
#NODE_RPC_BTC=https://mempool.space/api
#NODE_RPC_ZEC=https://api.blockchair.com/zcash
# Blocks of depth before an invoice is credited. Enforced, not decorative.
#ZTV_BTC_CONFIRMATIONS=1
#ZTV_ZEC_CONFIRMATIONS=5
# Monero needs a view-only wallet, not an explorer — the chain publishes
# neither recipient nor amount. scripts/setup-monero-watch.sh points
# monero-wallet-rpc at a PUBLIC remote node; no chain lands on this box.
#MONERO_WALLET_RPC=http://127.0.0.1:18083/json_rpc
#XMR_CONFIRMATIONS=10

# When ZTV_PAYMENT_PROVIDER=hosted:
#ZTV_PAYMENT_API_URL=https://api.example-gateway.com
#ZTV_PAYMENT_API_KEY=
#ZTV_PAYMENT_IPN_SECRET=
#ZTV_PAYMENT_IPN_URL=https://0trustvpn.com/api/v1/payment/webhook
#ZTV_PAYMENT_AUTH_HEADER=x-api-key
#ZTV_PAYMENT_SIG_HEADER=x-nowpayments-sig
#ZTV_PAYMENT_SIG_ALGO=sha512

# --- Free trial -------------------------------------------------------------
ZTV_TRIAL_ENABLED=1
ZTV_TRIAL_DAYS=7
ZTV_TRIAL_MAX_DEVICES=2
# Each extra bit doubles the browser's work. 20 is about a second on a phone.
ZTV_TRIAL_POW_BITS=20
# REQUIRED when trials are enabled: signs the challenges. Generate with
#   openssl rand -hex 32
# Without it /api/v1/trial returns 503 rather than accepting forgeable stamps.
ZTV_TRIAL_SECRET=
