# /etc/0trust/meshd.env — mesh node daemon
# Copy to /etc/0trust/meshd.env on each NODE (not the control plane),
# chmod 0640, chown root:0trust
#
# Written by scripts/bootstrap-node.sh for static nodes. Ephemeral RAM-only
# nodes get theirs from cloud-init after /api/v1/node/provision hands back a
# node id and a per-node PSK.

CONTROL_URL=https://0trustvpn.com

# For a static node this is the shared NODE_API_PSK from the control plane's
# api.env. For an ephemeral node it is the per-node PSK returned by
# /api/v1/node/provision — preferred, because rotating one node's credential
# then does not mean restarting the others.
NODE_API_PSK=

# Must match the id in the control plane's mesh_nodes table. meshd sends it
# with every heartbeat: a node authenticating with the shared PSK has no
# psk_hash row to match, so without this the control plane cannot tell which
# node just checked in.
NODE_ID=zur-01
NODE_ROLE=both          # entry | exit | both

WG_IFACE=wg0
WG_PRIVKEY=/etc/wireguard/wg0.key
WG_PORT=51820
MESH_GATEWAY=10.64.0.1/10
POLL_INTERVAL=30
