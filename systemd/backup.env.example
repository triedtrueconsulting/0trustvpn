# /etc/0trust/backup.env — encrypted database backups
# Copy to /etc/0trust/backup.env, chmod 0640, chown root:0trust
#
# The backup timer is installed but NOT enabled by scripts/install.sh, because
# it encrypts to an age recipient that does not exist until you make one.
# Enabling it before then just produces a failing unit every night.
#
# Set up:
#   apt-get install age
#   age-keygen -o /root/0trust-backup.key      # keep this OFF the server
#   grep 'public key' /root/0trust-backup.key  # -> /etc/0trust/backup-recipients.txt
#   systemctl enable --now 0trust-backup.timer
#
# The private key must live somewhere the server cannot reach. A backup you
# can decrypt with a key stored next to it protects you from disk failure and
# nothing else — least of all from someone who has taken the box.

ZTV_BACKUP_DIR=/var/lib/0trust/backups
ZTV_AGE_RECIPIENTS=/etc/0trust/backup-recipients.txt

# Optional offsite copy via rclone, e.g. "b2:0trust-backups".
# Leave empty to keep backups on the box only.
ZTV_OFFSITE=

# Retention, in days. docs/AUDIT.md states what we keep and for how long —
# change this and reconcile that document, or the audit pack becomes untrue.
ZTV_BACKUP_RETAIN_DAYS=14
