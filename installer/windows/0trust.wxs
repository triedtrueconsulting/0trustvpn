<?xml version="1.0" encoding="utf-8"?>
<!--
  0trust VPN — Windows MSI installer

  Built with WiX Toolset v4. To compile:

    dotnet tool install -g wix
    wix build 0trust.wxs -arch x64 -d Version=0.1.0 \
                                   -d BinaryDir=..\\..\\client\\dist \
                                   -o 0trust-0.1.0-x64.msi

  Then sign:
    signtool sign /n "Your Code Signing Cert" /tr http://timestamp.digicert.com \
                  /td sha256 /fd sha256 0trust-0.1.0-x64.msi

  What the installer does:
    1. Installs 0trust.exe to C:\Program Files\0trust\
    2. Adds 0trust to PATH (per-machine) so users can run it from any shell
    3. Creates Start Menu shortcut "0trust VPN" that launches the GUI
    4. Creates an Uninstall entry in Add/Remove Programs
    5. Verifies WireGuard for Windows is installed (LaunchCondition);
       if not, points the user at the download page
    6. Optionally registers an auto-start entry under HKCU\...\Run

  What it does NOT do:
    - Bundle WireGuard for Windows itself. We deliberately don't repackage
      Jason Donenfeld's installer; users get the official one from
      wireguard.com which is itself signed by ZX2C4 LLC. Our installer
      detects its presence and surfaces a friendly error if missing.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="0trust VPN"
           Manufacturer="0trust"
           Version="$(Version)"
           UpgradeCode="6f4c8d7a-2a1b-4d92-9c7a-7a3b0e8c5e90"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="0trust VPN — privacy-first mesh VPN client" />

    <!-- Major-upgrade behavior: replace older versions in place -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of 0trust VPN is already installed." />

    <Media Id="1" Cabinet="0trust.cab" EmbedCab="yes" />

    <!-- ===== Prerequisite check ===== -->
    <!--
      Look for WireGuard for Windows in the standard install location.
      We don't fail outright; we WARN and continue, since the user might
      install WireGuard right after running our installer.
    -->
    <Property Id="WIREGUARDINSTALLED">
      <DirectorySearch Id="WGCheckPF"  Path="[ProgramFiles64Folder]WireGuard">
        <FileSearch Name="wireguard.exe" />
      </DirectorySearch>
    </Property>

    <SetProperty Id="WIREGUARDMISSING" Value="1"
                 Before="LaunchConditions"
                 Sequence="both"
                 Condition="NOT WIREGUARDINSTALLED" />

    <!-- ===== UI ===== -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="ARPPRODUCTICON" Value="0trustIcon" />
    <Property Id="ARPHELPLINK" Value="https://0trustvpn.com/help" />
    <Property Id="ARPURLINFOABOUT" Value="https://0trustvpn.com/" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Icon Id="0trustIcon" SourceFile="resources\0trust.ico" />

    <!-- ===== Install layout ===== -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="0trust">
        <Component Id="MainBinary" Guid="*">
          <File Id="0trustExe"
                Source="$(BinaryDir)\0trust-windows-amd64.exe"
                Name="0trust.exe"
                KeyPath="yes" />
          <!-- Add Program Files\0trust to system PATH -->
          <Environment Id="PathEnv"
                       Name="PATH"
                       Action="set"
                       Part="last"
                       System="yes"
                       Value="[INSTALLFOLDER]" />
        </Component>

        <Component Id="LicenseFile" Guid="*">
          <File Source="License.rtf" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ===== ProgramData state directory ===== -->
    <!-- Holds the wg-quick config when a tunnel is active -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="0trust">
        <Component Id="DataFolder" Guid="*" KeyPath="yes">
          <CreateFolder>
            <!-- LocalSystem owns it (the WireGuard tunnel service reads from here) -->
            <util:PermissionEx xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
                               User="SYSTEM"
                               GenericAll="yes" />
            <util:PermissionEx xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
                               User="Administrators"
                               GenericAll="yes" />
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ===== Start Menu shortcut ===== -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuFolder" Name="0trust VPN">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="0trustGuiShortcut"
                    Name="0trust VPN"
                    Description="Open the 0trust VPN client"
                    Target="[INSTALLFOLDER]0trust.exe"
                    Arguments="gui"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="0trustIcon" />
          <Shortcut Id="0trustHelpShortcut"
                    Name="Help"
                    Description="Open 0trust help &amp; FAQ"
                    Target="https://0trustvpn.com/help" />
          <Shortcut Id="0trustUninstall"
                    Name="Uninstall 0trust VPN"
                    Target="[SystemFolder]msiexec.exe"
                    Arguments="/x [ProductCode]" />
          <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\0trust"
                         Name="StartMenuInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ===== Desktop shortcut (optional via Feature) ===== -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="0trustDesktopShortcut"
                  Name="0trust VPN"
                  Description="Open the 0trust VPN client"
                  Target="[INSTALLFOLDER]0trust.exe"
                  Arguments="gui"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="0trustIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\0trust"
                       Name="DesktopShortcutInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ===== Auto-start on user login (off by default; user enables) ===== -->
    <!-- This is opt-in via the InstallDir page checkbox -->
    <Component Id="AutoStart" Guid="*" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="0trust"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]0trust.exe&quot; gui --no-browser"
                     KeyPath="yes" />
    </Component>

    <!-- ===== Features ===== -->
    <Feature Id="Main" Title="0trust VPN" Display="expand" Level="1"
             AllowAdvertise="no" AllowAbsent="no">
      <ComponentRef Id="MainBinary" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DataFolder" />
    </Feature>

    <Feature Id="DesktopIcon" Title="Desktop shortcut" Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Feature Id="AutoStartFeature" Title="Launch on Windows startup" Level="1000">
      <!-- Level 1000 = unchecked by default; user opts in -->
      <ComponentRef Id="AutoStart" />
    </Feature>

    <!-- ===== WireGuard-missing notice ===== -->
    <!--
      Shown after install completes. Doesn't block install; user can install
      WireGuard for Windows separately and the tunnel will start working.
    -->
    <CustomAction Id="ShowWireguardWarning"
                  Script="vbscript"
                  Execute="immediate"
                  Return="check">
      <![CDATA[
        MsgBox "WireGuard for Windows is not installed." & vbCrLf & vbCrLf & _
               "Download it from https://wireguard.com/install/ — 0trust will start working " & _
               "once it's installed. (The 0trust app itself is installed correctly.)", _
               vbInformation, "0trust VPN"
      ]]>
    </CustomAction>
    <InstallExecuteSequence>
      <Custom Action="ShowWireguardWarning"
              After="InstallFinalize"
              Condition="NOT Installed AND WIREGUARDMISSING=1" />
    </InstallExecuteSequence>

  </Package>
</Wix>
