<?xml version="1.0" encoding="utf-8"?>
<!--
  0trustvpn — Windows MSI installer

  Built with WiX Toolset v4. To compile:

    dotnet tool install -g wix
    wix extension add -g WixToolset.UI.wixext
    wix extension add -g WixToolset.Util.wixext

    wix build 0trust.wxs -arch x64 ^
        -d Version=0.1.0 ^
        -d BinaryDir=..\..\client\dist ^
        -ext WixToolset.UI.wixext ^
        -ext WixToolset.Util.wixext ^
        -o 0trust-0.1.0-x64.msi

  Both -ext flags are required, not optional: this file uses ui:WixUI and
  util:PermissionEx. The command in this header used to omit them and did not
  build.

  For the ARM64 build, pass the matching architecture and binary:

    wix build 0trust.wxs -arch arm64 -d Version=0.1.0 ^
        -d Arch=arm64 -d BinaryDir=..\..\client\dist ^
        -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext ^
        -o 0trust-0.1.0-arm64.msi

  Then sign:
    signtool sign /n "Your Code Signing Cert" /tr http://timestamp.digicert.com ^
                  /td sha256 /fd sha256 0trust-0.1.0-x64.msi

  What the installer does:
    1. Installs 0trust.exe to C:\Program Files\0trust\
    2. Adds 0trust to PATH (per-machine) so users can run it from any shell
    3. Creates Start Menu shortcut "0trustvpn" that launches the GUI
    4. Creates an Uninstall entry in Add/Remove Programs
    5. Detects WireGuard for Windows and, if it is missing, says so on the
       installer's last page
    6. Optionally registers an auto-start entry
    7. On uninstall: stops the tunnel and deletes the tunnel config, which
       holds this device's WireGuard PRIVATE KEY. Leaving that on disk after
       someone has removed a privacy VPN is not acceptable.

  What it does NOT do:
    - Bundle WireGuard for Windows itself. We deliberately don't repackage
      Jason Donenfeld's installer; users get the official one from
      wireguard.com which is itself signed by ZX2C4 LLC. Our installer
      detects its presence and surfaces a friendly note if missing.
-->
<?ifndef Version ?><?define Version = "0.1.0" ?><?endif?>
<?ifndef Arch ?><?define Arch = "amd64" ?><?endif?>
<?ifndef BinaryDir ?><?define BinaryDir = "..\..\client\dist" ?><?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="0trustvpn"
           Manufacturer="0trust"
           Version="$(Version)"
           UpgradeCode="6f4c8d7a-2a1b-4d92-9c7a-7a3b0e8c5e90"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="0trustvpn — privacy-first mesh VPN client" />

    <!-- Major-upgrade behavior: replace older versions in place -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of 0trustvpn is already installed." />

    <Media Id="1" Cabinet="0trust.cab" EmbedCab="yes" />

    <!-- WireGuard for Windows needs Windows 7+; WireGuardNT wants 8.1+. -->
    <Launch Condition="Installed OR (VersionNT &gt;= 603)"
            Message="0trustvpn requires Windows 8.1 or later." />

    <!-- ===== Prerequisite check ===== -->
    <!--
      Look for WireGuard for Windows in the standard install location.
      We don't fail outright; we note it and continue, since the user might
      install WireGuard right after running our installer.
    -->
    <Property Id="WIREGUARDINSTALLED">
      <DirectorySearch Id="WGCheckPF"  Path="[ProgramFiles64Folder]WireGuard">
        <FileSearch Name="wireguard.exe" />
      </DirectorySearch>
    </Property>

    <!-- ===== UI ===== -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="ARPPRODUCTICON" Value="0trustIcon" />
    <Property Id="ARPHELPLINK" Value="https://0trustvpn.com/help" />
    <Property Id="ARPURLINFOABOUT" Value="https://0trustvpn.com/" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Icon Id="0trustIcon" SourceFile="resources\0trust.ico" />

    <!--
      The WireGuard-missing notice, on the installer's final page.

      This was a VBScript custom action popping a MsgBox after InstallFinalize.
      Three things wrong with that: VBScript is deprecated on Windows and is
      being removed from the OS, a modal dialog from InstallExecuteSequence
      hangs any silent or unattended install, and Return="check" meant a
      failure to show the message failed the whole installation. The exit
      dialog's optional text does the same job with no script at all, and is
      simply absent in a silent install.
    -->
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT"
                 Sequence="ui"
                 Before="ExecuteAction"
                 Condition="NOT Installed AND NOT WIREGUARDINSTALLED"
                 Value="0trustvpn is installed, but WireGuard for Windows is not. The VPN needs it for the data plane. Install it from https://www.wireguard.com/install/ and 0trustvpn will start working — nothing else to do here." />

    <!-- ===== Install layout ===== -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="0trust">
        <Component Id="MainBinary" Guid="*">
          <File Id="0trustExe"
                Source="$(BinaryDir)\0trust-windows-$(Arch).exe"
                Name="0trust.exe"
                KeyPath="yes" />
          <!-- Add Program Files\0trust to system PATH -->
          <Environment Id="PathEnv"
                       Name="PATH"
                       Action="set"
                       Part="last"
                       System="yes"
                       Value="[INSTALLFOLDER]" />
        </Component>

        <Component Id="LicenseFile" Guid="*">
          <File Source="License.rtf" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ===== ProgramData state directory ===== -->
    <!-- Holds the wg-quick config when a tunnel is active -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="0trust">
        <Component Id="DataFolder" Guid="*" KeyPath="yes">
          <CreateFolder>
            <!-- LocalSystem owns it (the WireGuard tunnel service reads from here) -->
            <util:PermissionEx User="SYSTEM" GenericAll="yes" />
            <util:PermissionEx User="Administrators" GenericAll="yes" />
          </CreateFolder>
          <!--
            On uninstall, take the tunnel config with us. It contains the
            device's WireGuard private key: a customer who removes a privacy
            VPN and is left with their key sitting in ProgramData has been
            handed a liability, not a clean uninstall.
          -->
          <RemoveFile Id="RemoveTunnelConfig" Name="*" On="uninstall" />
          <RemoveFolder Id="RemoveDataDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ===== Start Menu shortcut ===== -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuFolder" Name="0trustvpn">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="0trustGuiShortcut"
                    Name="0trustvpn"
                    Description="Open the 0trustvpn client"
                    Target="[INSTALLFOLDER]0trust.exe"
                    Arguments="gui"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="0trustIcon" />
          <Shortcut Id="0trustHelpShortcut"
                    Name="Help"
                    Description="Open 0trustvpn help &amp; FAQ"
                    Target="https://0trustvpn.com/help" />
          <Shortcut Id="0trustUninstall"
                    Name="Uninstall 0trustvpn"
                    Target="[SystemFolder]msiexec.exe"
                    Arguments="/x [ProductCode]" />
          <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
          <!--
            Per-machine package, per-machine keypath. These were HKCU, which
            puts per-user data in a component installed to an all-users folder
            (ICE38/ICE57) — the shortcut would be reference-counted against
            whichever administrator happened to run setup.
          -->
          <RegistryValue Root="HKLM"
                         Key="Software\0trust"
                         Name="StartMenuInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ===== Desktop shortcut (optional via Feature) ===== -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="0trustDesktopShortcut"
                  Name="0trustvpn"
                  Description="Open the 0trustvpn client"
                  Target="[INSTALLFOLDER]0trust.exe"
                  Arguments="gui"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="0trustIcon" />
        <RegistryValue Root="HKLM"
                       Key="Software\0trust"
                       Name="DesktopShortcutInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ===== Auto-start on login (off by default; user opts in) ===== -->
    <!--
      HKLM, not HKCU, for the same per-machine reason as above.

      Worth knowing: this only auto-starts the GUI. The tunnel itself already
      survives a reboot without it, because `0trust connect` registers a
      Windows service through wireguard.exe /installtunnelservice, and that
      service starts at boot with no user logged in at all.
    -->
    <Component Id="AutoStart" Guid="*" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="0trustvpn"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]0trust.exe&quot; gui --no-browser"
                     KeyPath="yes" />
    </Component>

    <!-- ===== Features ===== -->
    <Feature Id="Main" Title="0trustvpn" Display="expand" Level="1"
             AllowAdvertise="no" AllowAbsent="no">
      <ComponentRef Id="MainBinary" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DataFolder" />
    </Feature>

    <Feature Id="DesktopIcon" Title="Desktop shortcut" Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Feature Id="AutoStartFeature" Title="Launch on Windows startup" Level="1000">
      <!-- Level 1000 = unchecked by default; user opts in -->
      <ComponentRef Id="AutoStart" />
    </Feature>

    <!-- ===== Stop the tunnel before we delete the binary that owns it ===== -->
    <!--
      Uninstalling used to leave the WireGuardTunnel$0trust0 service running
      with our config, so the machine kept routing all its traffic through a
      VPN whose client had just been removed and whose subscription would
      eventually lapse. `0trust disconnect` calls
      wireguard.exe /uninstalltunnelservice.

      Deferred and non-impersonating so it runs with the elevated token, and
      Return="ignore" because a machine with no tunnel up is the common case
      and must not fail the uninstall.
    -->
    <CustomAction Id="StopTunnelOnUninstall"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]0trust.exe&quot; disconnect"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopTunnelOnUninstall"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
