# ─── Secrets & operator state (NEVER commit) ───
*.env
!systemd/api.env.example
*.key
*.asc
!**/pubkey.asc.example
*.jks
*.keystore
keystore.properties
/etc/0trust/
backup-recipients.txt
*.db
*.db-wal
*.db-shm
*.sqlite
*.age
.snap-*

# ─── Go build artifacts ───
client/dist/
# tests/emulation/test_obfs.py [5] writes a probe command into the MODULE —
# it has to, because it imports internal/obfs and Go forbids importing an
# internal package across module boundaries, so it cannot live in /tmp. It is
# removed in a finally, but a run that is killed (Ctrl-C, a timeout, a stopped
# CI job) leaves it behind, and then `go vet ./...` compiles a test artefact
# and `git status` is dirty for a reason nobody remembers. Ignored by pattern
# so the per-run suffix is covered too.
client/cmd/obfsproxyprobe*/
*.exe
*.test
*.out

# ─── Android build artifacts ───
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/captures/

# ─── iOS build artifacts ───
# The .xcodeproj is GENERATED from project.yml by `xcodegen generate`. A
# committed project.pbxproj conflicts on every branch and hides what changed;
# project.yml is the reviewable source of the same information.
mobile/ios/0trust.xcodeproj/
mobile/ios/build/
mobile/ios/DerivedData/
mobile/ios/*.xcworkspace/
**/xcuserdata/

# ─── Installer outputs ───
installer/linux/deb/out/
installer/linux/appimage/out/
installer/windows/*.msi
installer/windows/obj/
installer/windows/bin/
*.AppImage
*.deb

# ─── Test emulation scratch (logs from a live stack run) ───
tests/emulation/run/

# ─── Python ───
__pycache__/
*.pyc
.venv/
venv/

# ─── OS / editor ───
.DS_Store
*.swp
.idea/
.vscode/
*.iml

# ─── Node (if any tooling is added later) ───
node_modules/
