# /etc/0trust/btcpay-backup.env
# Source: chmod 0600 and edit before enabling the backup timer.

# age public key to encrypt backups to. Keep the SECRET key off this host —
# storing it here defeats the purpose. Generate with: age-keygen -o key.txt
BACKUP_AGE_RECIPIENT=age1examplekeyreplaceme

# Where to write the local copy before shipping off-host
BACKUP_DIR=/var/backups/0trust

# How many days of backups to keep on this host
RETAIN_DAYS=30
